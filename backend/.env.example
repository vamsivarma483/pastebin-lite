# Example environment variables for backend
# Copy this to .env and fill in your actual values

# PostgreSQL Database URL
# Choose ONE option below:

# Option 1: Local PostgreSQL (Development)
DATABASE_URL="postgresql://postgres:password@localhost:5432/pastebin_lite?schema=public"

# Option 2: Neon (Serverless PostgreSQL - Recommended)
# Free tier: https://neon.tech
# Get connection string: https://console.neon.tech/app/projects
# DATABASE_URL="postgresql://user:password@ep-region.neon.tech/pastebin_lite?sslmode=require"

# Option 3: Vercel Postgres
# https://vercel.com/docs/storage/vercel-postgres
# DATABASE_URL="postgresql://user:password@region.postgres.vercel-storage.com/pastebin_lite"

# Node environment
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
TEST_MODE="0"

# Server port
PORT=3001

# Enable test mode for deterministic testing
# When set to 1, respects x-test-now-ms header for expiry testing
TEST_MODE="0"

# Frontend URL (for CORS and redirect URLs)
FRONTEND_URL="http://localhost:3000"
